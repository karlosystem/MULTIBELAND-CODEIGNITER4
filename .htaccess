<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /multibeland/

    # Si el archivo o directorio existe en la raiz, se usa directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirige todo de forma interna a la carpeta public
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>